<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.berwilson.cron-contacts-sync</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>-c</string>
    <string>curl -sS -m 850 -H "Authorization: Bearer $(grep '^CRON_SECRET=' __APP_DIR__/.env.local | cut -d= -f2-)" http://localhost:3000/api/cron/contacts-sync</string>
  </array>
  <!-- Nightly at 2:45am. Deliberately in the quiet block before the Drive jobs
       and well clear of the 5:30 lead sweep: this one competes for nothing but
       Google API quota, and running it while somebody is typing a mail would
       mean their autocomplete list changing under them. -->
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>2</integer>
    <key>Minute</key>
    <integer>45</integer>
  </dict>
  <key>AbandonProcessGroup</key>
  <false/>
  <key>StandardOutPath</key>
  <string>__LOG_DIR__/cron-contacts-sync.log</string>
  <key>StandardErrorPath</key>
  <string>__LOG_DIR__/cron-contacts-sync.err.log</string>
</dict>
</plist>
