<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.berwilson.cron-drive-sync</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>-c</string>
    <string>curl -sS -m 1700 -H "Authorization: Bearer $(grep '^CRON_SECRET=' __APP_DIR__/.env.local | cut -d= -f2-)" http://localhost:3000/api/cron/drive-sync</string>
  </array>
  <!-- Nightly at 3:15am, BEFORE the lead sweep at 5:30 — a capability statement
       dropped in the folder yesterday should be available as evidence when this
       morning's leads are scored. No-ops when no folder is configured. -->
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>3</integer>
    <key>Minute</key>
    <integer>15</integer>
  </dict>
  <key>AbandonProcessGroup</key>
  <false/>
  <key>StandardOutPath</key>
  <string>__LOG_DIR__/cron-drive-sync.log</string>
  <key>StandardErrorPath</key>
  <string>__LOG_DIR__/cron-drive-sync.err.log</string>
</dict>
</plist>
