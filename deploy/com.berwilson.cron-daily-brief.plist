<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.berwilson.cron-daily-brief</string>
  <!--
    ⚠ HELD SINCE 2026-10-21. src/lib/notify/policy.ts holds `weekly_brief`, so this
    route returns immediately and sends nothing — the agent stays loaded and
    scheduled on purpose, because ONE switch is better than two that have to
    agree. The reason, and the one word that reverses it, are in that table;
    /settings/health → Outbound Messaging says so on screen.
  -->
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>-c</string>
    <string>curl -sS -m 1700 -H "Authorization: Bearer $(grep '^CRON_SECRET=' __APP_DIR__/.env.local | cut -d= -f2-)" http://localhost:3000/api/cron/daily-brief</string>
  </array>
  <!-- Weekly, Monday 6:30am local. Weekday 1 = Monday. -->
  <key>StartCalendarInterval</key>
  <dict>
    <key>Weekday</key>
    <integer>1</integer>
    <key>Hour</key>
    <integer>6</integer>
    <key>Minute</key>
    <integer>30</integer>
  </dict>
  <key>StandardOutPath</key>
  <string>__LOG_DIR__/cron-daily-brief.log</string>
  <key>StandardErrorPath</key>
  <string>__LOG_DIR__/cron-daily-brief.err.log</string>
</dict>
</plist>
