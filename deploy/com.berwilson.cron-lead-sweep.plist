<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.berwilson.cron-lead-sweep</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>-c</string>
    <string>curl -sS -m 3500 -H "Authorization: Bearer $(grep '^CRON_SECRET=' __APP_DIR__/.env.local | cut -d= -f2-)" http://localhost:3000/api/cron/lead-sweep</string>
  </array>
  <!-- Daily at 4:30am, ahead of the workday: bid invitations that arrived
       overnight are triaged and scored before anyone opens the queue.
       Deliberately separate from the hourly deal sweep so the two never
       compete for the local model.

       Moved from 5:30 on 2026-09-23. The sweep runs the better part of an
       hour, so at 5:30 it was still issuing model calls when the Monday
       weekly brief started at 6:30 — and LM Studio serves one request at a
       time. The brief timed out and no brief was written that week. A 45-min
       run budget (RUN_BUDGET_MS) plus this start time leaves a clear hour. -->
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>4</integer>
    <key>Minute</key>
    <integer>30</integer>
  </dict>
  <!-- Never run two slices at once: the phases are resumable, not reentrant. -->
  <key>AbandonProcessGroup</key>
  <false/>
  <key>StandardOutPath</key>
  <string>__LOG_DIR__/cron-lead-sweep.log</string>
  <key>StandardErrorPath</key>
  <string>__LOG_DIR__/cron-lead-sweep.err.log</string>
</dict>
</plist>
