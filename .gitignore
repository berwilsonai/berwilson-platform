# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# offline basemap assets (fetched by scripts/setup-map-data.sh; deployed via rsync working tree)
/public/basemaps/

# Supabase CLI scratch state — machine-specific, and actively misleading once
# the DB moves. These files still pointed at the retired hosted project long
# after the platform moved to self-hosted Supabase on the Studio, which is how
# `supabase db push --linked` came to target the wrong database entirely.
supabase/.temp/
